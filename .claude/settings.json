{
  "permissions": {
    "allow": [
      "Bash(gh run watch *)",
      "Bash(lms ps)",
      "Bash(lms ps *)",
      "Bash(lms ls)",
      "Bash(lms ls *)",
      "Bash(.venv/bin/pytest)",
      "Bash(.venv/bin/pytest -q)",
      "Bash(.venv/bin/pytest -m \"not integration\")",
      "Bash(.venv/bin/ruff check)",
      "Bash(.venv/bin/ruff check .)",
      "Bash(.venv/bin/ruff format --check .)",
      "Bash(/Users/fons/Documents/programs/pdf-worker/.venv/bin/pytest /Users/fons/Documents/programs/pdf-worker)",
      "Bash(/Users/fons/Documents/programs/pdf-worker/.venv/bin/pytest /Users/fons/Documents/programs/pdf-worker -q)",
      "Bash(/Users/fons/Documents/programs/pdf-worker/.venv/bin/pytest -m \"not integration\" /Users/fons/Documents/programs/pdf-worker)",
      "Bash(/Users/fons/Documents/programs/pdf-worker/.venv/bin/pytest -m \"not integration\" /Users/fons/Documents/programs/pdf-worker -q)",
      "Bash(/Users/fons/Documents/programs/pdf-worker/.venv/bin/ruff check /Users/fons/Documents/programs/pdf-worker)",
      "Bash(git -C /Users/fons/Documents/programs/pdf-worker status)",
      "Bash(git -C /Users/fons/Documents/programs/pdf-worker status *)",
      "Bash(git -C /Users/fons/Documents/programs/pdf-worker diff *)",
      "Bash(git -C /Users/fons/Documents/programs/pdf-worker log *)",
      "Bash(git -C /Users/fons/Documents/programs/pdf-worker show *)",
      "Bash(/opt/homebrew/bin/epubcheck *)",
      "Bash(git -C /Users/fons/Documents/programs/ai-client status)",
      "Bash(git -C /Users/fons/Documents/programs/ai-client status *)",
      "Bash(git -C /Users/fons/Documents/programs/ai-client diff *)",
      "Bash(git -C /Users/fons/Documents/programs/ai-client log *)",
      "Bash(/Users/fons/Documents/programs/pdf-worker/.venv/bin/ruff check /Users/fons/Documents/programs/pdf-worker/src /Users/fons/Documents/programs/pdf-worker/tests)",
      "Bash(/Users/fons/Documents/programs/pdf-worker/.venv/bin/ruff format --check *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cat >/dev/null || true; command -v code-review-graph >/dev/null 2>&1 || exit 0; git rev-parse --git-dir >/dev/null 2>&1 && code-review-graph update --skip-flows --repo \"$(git rev-parse --show-toplevel 2>/dev/null)\" || true",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cat >/dev/null || true; command -v code-review-graph >/dev/null 2>&1 || exit 0; git rev-parse --git-dir >/dev/null 2>&1 && code-review-graph status --repo \"$(git rev-parse --show-toplevel 2>/dev/null)\" || echo 'Not a git repo, skipping'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
